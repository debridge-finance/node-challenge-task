# Production environment variables
NODE_ENV=production
AUTO_SEED=false

# Database
DB_SSL=true
DB_LOGGING=false
DB_POOL_SIZE=20

# Kafka - will be overridden by actual production values
# KAFKA_BROKERS=kafka-prod-1:9092,kafka-prod-2:9092

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Performance
PARALLEL_UPDATES=true
UPDATE_BATCH_SIZE=50