# Test environment variables
NODE_ENV=test
AUTO_SEED=false

# Test database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tokens_test
DB_USER=test
DB_PASSWORD=test
DB_LOGGING=false

# Test Kafka
KAFKA_BROKERS=localhost:9093

# Fast updates for tests
UPDATE_INTERVAL_SECONDS=1
UPDATE_BATCH_SIZE=5

# Logging
LOG_LEVEL=error
LOG_PRETTY=false