# Environment
NODE_ENV=development

# Application
PORT=3000
API_PREFIX=api
AUTO_SEED=false

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tokens
DB_LOGGING=false
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=60000
DB_SSL=false

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=token-price-service
KAFKA_CONNECTION_TIMEOUT=60000
KAFKA_REQUEST_TIMEOUT=30000
KAFKA_INITIAL_RETRY_TIME=100
KAFKA_RETRIES=8
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_TOPIC_PRICE_UPDATES=token-price-updates

# Price Update Configuration
UPDATE_INTERVAL_SECONDS=5
UPDATE_BATCH_SIZE=10
PARALLEL_UPDATES=false

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true