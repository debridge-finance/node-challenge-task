# general
NODE_ENV=development

# postgres database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# kafka connection
KAFKA_CLIENT_ID=token-price-service
KAFKA_BROKERS=localhost:9092,otherhost:9092

# price update
## update loop params
PRICE_UPDATE_TIMEOUT=5000
PRICE_BATCH_SIZE=1000
## mocked price retrieval delay
PRICE_MIN_UPDATE_DELAY=50
PRICE_MAX_UPDATE_DELAY=200
## max value of randomly generated price
PRICE_MAX_RANDOM=100000

