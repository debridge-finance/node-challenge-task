# ================================
# TOKEN PRICE SERVICE
# Environment Variables Template
# ================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env in the project root
# 2. Update values as needed for your environment
# 3. Never commit .env file to git!
#
# Usage:
#   cp env.example.txt .env
#

# ================================
# APPLICATION CONFIGURATION
# ================================

# Node Environment (development | production | test | staging)
NODE_ENV=development

# Application Name
APP_NAME=Token Price Service

# Application Port
APP_PORT=3000

# ================================
# DATABASE CONFIGURATION
# ================================

# PostgreSQL Connection
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=password
PG_DB=token_price_service

# TypeORM Logging (true | false)
TYPEORM_LOGGING=false

# Database Connection Pool
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=1000
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30000

# ================================
# REDIS CONFIGURATION
# ================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ================================
# MESSAGING (KAFKA) CONFIGURATION
# ================================

# Kafka Brokers (comma-separated for multiple brokers)
# Example: broker1:9092,broker2:9092,broker3:9092
MESSAGING_BROKERS=localhost:9092

# Kafka Client ID
MESSAGING_CLIENT_ID=token-price-service

# Kafka Topics
MESSAGING_TOPIC_PRICE_UPDATES=token-price-updates
MESSAGING_TOPIC_ERRORS=system-errors

# Messaging Options
MESSAGING_RETRIES=3
MESSAGING_TIMEOUT=5000
MESSAGING_COMPRESSION=gzip

# ================================
# HTTP CONFIGURATION
# ================================

# CORS Origins (comma-separated)
# Example: http://localhost:3000,http://localhost:3001,https://example.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# MONITORING CONFIGURATION
# ================================
# Note: These are used by docker-compose, not by the application code

PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
METRICS_ENABLED=true
